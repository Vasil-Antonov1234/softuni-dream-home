<main class="dashboard">
    <section id="dashboard">
        <h2>Properties</h2>
        <ul class="property-wrapper">
            <!-- Display a li with information about every post (if any)-->
            <li class="property">
                <img src="./static/images/house.jpg" />
                <p>
                    <strong>Type: </strong><span class="type">House</span>
                </p>
                <p>
                    <strong>Area </strong><span class="area">499 sq.m</span>
                </p>
                <p>
                    <strong>Location: </strong><span class="location">Plovdiv</span>
                </p>
                <a class="details-btn" href="#">Details</a>
            </li>

            <li class="property">
                <img src="./static/images//apartment.jpg" />
                <p>
                    <strong>Type: </strong><span class="type">Apartment</span>
                </p>
                <p>
                    <strong>Area </strong><span class="area">102 sq.m</span>
                </p>
                <p>
                    <strong>Location: </strong><span class="location">Sofia</span>
                </p>
                <a class="details-btn" href="#">Details</a>
            </li>

            <li class="property">
                <img src="./static/images/store.jpg" />
                <p>
                    <strong>Type: </strong><span class="type">Store</span>
                </p>
                <p>
                    <strong>Area </strong><span class="area">300 sq.m</span>
                </p>
                <p>
                    <strong>Location: </strong><span class="location">Sofia</span>
                </p>
                <a class="details-btn" href="#">Details</a>
            </li>
        </ul>

        <!-- Display an h2 if there are no posts -->
        <!-- <div id="no-post">
                    <h2>There are no properties yet! </h2>
                    </div> -->
