<main class="dashboard">
    <section id="dashboard">
        <h2>Properties</h2>
        <ul class="property-wrapper">
            <!-- Display a li with information about every post (if any)-->
            {{#each properties}}
            <li class="property">
                <img src="{{image}}" />
                <p>
                    <strong>Type: </strong><span class="type">{{type}}</span>
                </p>
                <p>
                    <strong>Area </strong><span class="area">{{area}} sq.m</span>
                </p>
                <p>
                    <strong>Location: </strong><span class="location">{{location}}</span>
                </p>
                <a class="details-btn" href="#">Details</a>
            </li>
            {{else}}
            <!-- Display an h2 if there are no posts -->
            <div id="no-post">
                <h2>There are no properties yet! </h2>
            </div>
            {{/each}}
        </ul>

    </section>
</main>