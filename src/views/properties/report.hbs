<main class="report-section">
    <section id="report-section">
        <h2>Report</h2>
        <ul class="report-list">
            {{#if errorMesage}}
            <!-- Display an h2 if an error occurs -->
            <h2 id="no-post">{{errorMesage}}</h2>
            {{else}}
            {{#each latest}}
            <!-- Display a li with information about every post (if any)-->
            <li class="report-property">
                <img src="{{image}}" />
                <div>
                    <h3>{{type}}</h3>
                    <p><strong>Price:</strong> <br> {{price}} EUR</p>
                    <p><strong>Contact:</strong> <br> {{contact}}</p>
                    <p><strong>Location:</strong> <br>{{location}}</p>
                    <p><strong>Area:</strong> <br> {{area}} sq.m</p>
                    <p><strong>Created on:</strong> <br>{{createdAt}}</p>
                    <p><strong>Owner:</strong> <br> {{owner.email}}</p>
                </div>
            </li>
            {{else}}
            <!-- Display an h2 if there are no posts -->
            <h2 id="no-post">There are no properties yet! </h2>
            {{/each}}
            {{/if}}

        </ul>



    </section>
</main>