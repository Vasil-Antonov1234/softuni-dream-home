<main class="create">
    <!-- create Page (Only for logged-in users) -->
    <section id="create">
        <div class="form">
            <h2>Add Property</h2>
            <form class="create-form">
                <input type="text" id="type" placeholder="Type" />
                <input type="text" id="location" placeholder="Location" />
                <input type="number" id="area" placeholder="Area" />
                <input type="text" id="image-url" placeholder="Image URL" />
                <input type="number" id="price" placeholder="Price" />
                <input type="number" id="contact" placeholder="For Contacts..." />
                <textarea id="description" placeholder="Description..." name=""></textarea>
                <button type="submit">Create</button>
            </form>

        </div>
    </section>
</main>