<main class="edit">
    <!-- Edit Page (Only for logged-in users) -->
    <section id="edit">
        <div class="form">
            <h2>Edit Property Info</h2>
            <form class="edit-form" method="POST">
                <input type="text" id="type" placeholder="Type" name="type" value="{{property.type}}" />
                <input type="text" id="location" placeholder="Location" name="location" value="{{property.location}}" />
                <input type="number" id="area" placeholder="Area" name="area" value="{{property.area}}" />
                <input type="text" id="image-url" placeholder="Image URL" name="image" value="{{property.image}}" />
                <input type="number" id="price" placeholder="Price" name="price" value="{{property.price}}" />
                <input type="number" id="contact" placeholder="For Contacts..." name="contact" value="{{property.contact}}" />
                <textarea id="description" placeholder="Description..." name="description">{{property.description}}</textarea>
                <button type="submit">Edit</button>
            </form>

        </div>
    </section>
</main>