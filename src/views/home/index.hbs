<main class="home">
    <!-- Home page -->
    <section id="home">
        <h1>Dream Home: Your New Life Starts Here!</h1>
        <h2>Discover your perfect property among thousands of verified listings. Whether you are looking for a
            cozy apartment, a spacious house, or an affordable land plot, at Dream Home you will find your new
            home easily and securely.</h2>


        <section id="last-added">
            
            {{#each properties}}
            <div>
                <img src="{{image}}">
                <div id="text-content">
                    <p>Type: {{type}}</p>
                    <p>Area: {{area}} sq.m</p>
                </div>
                <a class="details-btn" href="/properties/{{id}}/details">Details</a>
            </div>
            {{else}}
            <p class="no-post">There are no properties yet!</p>
            {{/each}}
        </section>
    </section>
</main>